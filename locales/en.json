    "tables": {
        "1": {
            "story": "Table of 1 is easy! Everything stays the same.",
            "tip": "Any number × 1 = that number",
            "astuce": "When multiplying by 1, the result never changes.",
            "indice": "It's the same number: we don't really multiply.",
            "erreur": "1 × X = X. Use the exact same number."
        },
        "2": {
            "story": "Table of 2 is doubling! Like twins.",
            "tip": "Count by 2s: 2, 4, 6, 8, 10...",
            "astuce": "Double the number: 2, 4, 6, 8...",
            "indice": "If you know +2, you know table of 2.",
            "erreur": "2 × X = X + X. Just double the number."
        },
        "3": {
            "story": "Table of 3, count by jumps of 3!",
            "tip": "Count by 3s: 3, 6, 9, 12, 15...",
            "astuce": "Add 3 each time, like 3, 6, 9, 12...",
            "indice": "Think of multiples of 3: 3, 6, 9, 12, 15...",
            "erreur": "3 × X = X + X + X. Add 3 each time."
        },
        "4": {
            "story": "Table of 4 is doubling twice!",
            "tip": "Double the number, then double again",
            "astuce": "4, 8, 12, 16... always add 4.",
            "indice": "You can do ×2 then ×2 again: double twice!",
            "erreur": "4 × X = (2 × X) × 2. Double twice to find the result."
        },
        "5": {
            "story": "Table of 5, look at your fingers! Ends in 0 or 5.",
            "tip": "Results always end with 0 or 5",
            "astuce": "Results always end in 0 or 5.",
            "indice": "Count by 5s: 5, 10, 15, 20...",
            "erreur": "5 × X = number ending in 0 or 5. Count by 5s to check."
        },
        "6": {
            "story": "Table of 6 is 5 + 1 more!",
            "tip": "Use table of 5 and add the number",
            "astuce": "If you know ×3, double the result: 6 = 3+3.",
            "indice": "Do 3 × X, then double it.",
            "erreur": "6 × X = 3 × X + 3 × X. Double the result of table of 3."
        },
        "7": {
            "story": "Table of 7, the hardest! Use stories.",
            "tip": "Learn with images and stories",
            "astuce": "Harder table: think of decomposition (5 × X + 2 × X).",
            "indice": "Do 5 × X, then add 2 × X.",
            "erreur": "7 × X = 5 × X + 2 × X. Split it to find easier."
        },
        "8": {
            "story": "Table of 8, double table of 4!",
            "tip": "Use table of 4 and double the result",
            "astuce": "8 is 2 × 2 × 2: double three times!",
            "indice": "Double, then double, then double again.",
            "erreur": "8 × X = double 3 times: X → 2X → 4X → 8X."
        },
        "9": {
            "story": "Table of 9, the magic fingers trick!",
            "tip": "Digits of result always sum to 9",
            "astuce": "The sum of digits often equals 9.",
            "indice": "Ex: 9 × 4 = 36 → 3 + 6 = 9.",
            "erreur": "Check digit sum: must often be 9 for ×9."
        },
        "10": {
            "story": "Table of 10, just add a zero!",
            "tip": "Add a 0 at the end of the number",
            "astuce": "Add a 0 at the end.",
            "indice": "10 × X = X with a zero behind.",
            "erreur": "10 × X = X0. Just write a zero at the end."
        }
    },
